# GEMINI_API_KEY: Optional in AI_MODE=demo; required only when AI_MODE=provider.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# Runtime & Environment Mode
NODE_ENV="development"
DEMO_MODE="true"

# Local-First Embedded PostgreSQL Persistence (File-backed PGlite directory)
# Persists multi-tenant organizations, agents, runs, events, approvals, and audit logs across restarts.
PGLITE_DATA_DIR=".local/aegis-db"

# Optional External PostgreSQL Connection String (for Docker Compose / external Postgres adapter)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/agent_platform"

# Authentication (Development/Demo secret placeholder — replace in production)
AUTH_SECRET="replace-with-local-random-value-at-least-16-chars"
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# AI Model Execution Mode: "demo" (deterministic mock, zero keys) | "local" | "provider" (live free-tier cloud AI)
AI_MODE="demo"
AI_PROVIDER_API_KEY=""
AI_PROVIDER_MODEL="gemini-3-flash-preview"

# Free-Tier Cloud AI Provider Keys (Server-Side Only — Never Exposed to Browser)
# Configure any one or more of the following keys to enable live inference for that provider:
# - Google Gemini Free Tier (gemini-3-flash-preview): https://aistudio.google.com/apikey
# - OpenAI ChatGPT Free Tier (gpt-4o-mini): https://platform.openai.com/api-keys
# - Anthropic Claude Free Tier (claude-3-5-haiku-latest): https://console.anthropic.com/
# - xAI Grok Free Tier (grok-2-latest): https://console.x.ai/
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
XAI_API_KEY=""

# Local Document Upload Guardrails
UPLOAD_DIR=".local/uploads"
MAX_UPLOAD_BYTES="10485760"

# Bounded Agent Runtime Guardrails
RUN_MAX_STEPS="8"
RUN_MAX_TOOL_CALLS="6"
RUN_TIMEOUT_SECONDS="120"

# Background Worker Queue Settings
WORKER_POLL_INTERVAL_MS="1000"
WORKER_CONCURRENCY="2"
WORKER_LEASE_MS="30000"
