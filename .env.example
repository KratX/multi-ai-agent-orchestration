# ============================================================================
# ORDARIS RUNTIME (v1.0.0-demo) — INTERACTIVE ENTERPRISE AGENT SANDBOX (.env TEMPLATE)
# ============================================================================
# Quickstart:
#   cp .env.example .env
#   pnpm dev
#
# All server & AI execution logs are written to:
#   1. Terminal stdout/stderr
#   2. Local log file: .local/logs/ordaris-runtime.log
#   3. Live HTTP endpoint: GET http://localhost:3000/api/v1/logs
# ============================================================================

# ----------------------------------------------------------------------------
# 1. FREE-TIER CLOUD AI API KEYS (Server-Side Fallback — Never Exposed to Browser)
# ----------------------------------------------------------------------------
# Ordaris Runtime resolves AI engines using a 3-Tier Fallback Hierarchy:
#   Tier 1: Session BYOK Vault Key (entered via browser Session Key Drawer)
#   Tier 2: Server .env Key (configured below)
#   Tier 3: Deterministic Simulation Engine (100% offline zero-key fallback)
#
# Add ANY ONE (or more) of the keys below in your local `.env` file.
# If no key is set in Session BYOK or `.env`, Ordaris Runtime automatically executes
# via the Deterministic Simulation Engine and logs a structured diagnostic entry
# in `.local/logs/ordaris-runtime.log`.

# [Option A — Recommended 100% Free Tier, No Credit Card Required]
# Google Gemini Free Tier (Model: gemini-3-flash-preview)
# Get free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=""
AI_PROVIDER_API_KEY=""
AI_PROVIDER_MODEL="gemini-3-flash-preview"

# [Option B — OpenAI ChatGPT Free Tier / GitHub Models Free Tier]
# Model: gpt-4o-mini
# - Official OpenAI Key: https://platform.openai.com/api-keys
# - OR 100% Free via GitHub Models: set OPENAI_API_KEY to a free GitHub Personal
#   Access Token (https://github.com/settings/tokens) and set:
#   OPENAI_BASE_URL="https://models.inference.ai.azure.com/chat/completions"
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1/chat/completions"

# [Option C — Anthropic Claude Free Tier]
# Model: claude-3-5-haiku-latest
# Get key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""

# [Option D — xAI Grok Free Tier]
# Model: grok-2-latest
# Get key: https://console.x.ai/
XAI_API_KEY=""
XAI_BASE_URL="https://api.x.ai/v1/chat/completions"

# [Option E — OpenRouter Unified Free-Tier Key (Optional)]
# Single free key that can route to free-tier ChatGPT, Claude, Grok, or Llama models:
# Get free key: https://openrouter.ai/keys
OPENROUTER_API_KEY=""

# ----------------------------------------------------------------------------
# 2. RUNTIME, DATABASE & WORKER CONFIGURATION
# ----------------------------------------------------------------------------
APP_URL="http://localhost:3000"
NODE_ENV="development"
DEMO_MODE="true"

# AI_MODE: "demo" (allows booting with 0 keys; live UI uses any key configured above)
# Set AI_MODE="provider" only if you want startup to fail fast when no key is set.
AI_MODE="demo"

# Database Driver Selection: "auto" (uses external PostgreSQL when DATABASE_URL is reachable, or falls back to PGlite), "postgres", or "pglite"
DB_DRIVER="auto"

# Local-First Embedded PostgreSQL Persistence (File-backed PGlite directory)
PGLITE_DATA_DIR=".local/ordaris-db"

# External PostgreSQL 16 Connection String (for Docker Compose or Managed Postgres)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/agent_platform"

# Authentication (Development/Demo secret placeholder — replace in production)
AUTH_SECRET="replace-with-local-random-value-at-least-16-chars"
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Local Document Upload Guardrails
UPLOAD_DIR=".local/uploads"
MAX_UPLOAD_BYTES="10485760"

# Bounded Agent Runtime Guardrails
RUN_MAX_STEPS="8"
RUN_MAX_TOOL_CALLS="6"
RUN_TIMEOUT_SECONDS="120"

# Background Worker Queue Settings
WORKER_POLL_INTERVAL_MS="1000"
WORKER_CONCURRENCY="2"
WORKER_LEASE_MS="30000"
WORKER_HEARTBEAT_INTERVAL_MS="10000"
