{
  "name": "aegis-runtime",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "dev:client": "vite --port=3000 --host=0.0.0.0",
    "dev:api": "tsx src/server/http/server.ts",
    "dev:worker": "tsx src/server/worker/main.ts",
    "start": "NODE_ENV=production tsx server.ts",
    "start:api": "NODE_ENV=production tsx src/server/http/server.ts",
    "start:worker": "NODE_ENV=production tsx src/server/worker/main.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=2 tests/unit/*.test.ts tests/integration/*.test.ts tests/security/*.test.ts",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "test:integration": "tsx --test tests/integration/*.test.ts",
    "test:security": "tsx --test tests/security/*.test.ts",
    "seed": "tsx src/server/seed/demo-seed.ts",
    "db:up": "docker compose up -d",
    "db:stop": "docker compose stop",
    "db:logs": "docker compose logs -f postgres"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.4",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21"
  }
}
